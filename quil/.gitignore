# ============================================================
# Quila — Tauri + Rust + Python + JavaScript .gitignore
# ============================================================

# ─── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.egg-link
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
.env
.env.*
!.env.example

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# mypy / ruff / pyright
.mypy_cache/
.ruff_cache/
pyrightconfig.json

# Jupyter
.ipynb_checkpoints/

# ─── Rust / Cargo ────────────────────────────────────────────
target/
# Cargo.lock is intentionally committed for this binary/app crate (reproducible builds)
**/*.rs.bk
*.pdb

# ─── Node / JavaScript ───────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
dist/
.cache/
*.tsbuildinfo

# ─── Tauri ───────────────────────────────────────────────────
src-tauri/target/
src-tauri/WixTools/
# Tauri bundle outputs
src-tauri/gen/
*.app
*.dmg
*.deb
*.AppImage
*.msi
*.exe

# ─── Editor / IDE ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# ─── Secrets / Keys ─────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
secrets.json
secrets.yaml
secrets.toml

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── OS / misc ───────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.orig

# ─── Distribution (not using DMG releases) ───────────────────
bundle.sh
